<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="Wall" Name="CE_ReinforcedWall">
		<defName>CE_ReinforcedWall</defName>
		<label>reinforced wall</label>
		<description>A strong impassable wall reinforced with steel plates made to withstand lots of abuse and direct explosions. Capable of holding up a roof.</description>
		<graphicData>
			<texPath>Things/Building/Structure/ReinforcedWall/ReinforcedWall_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconPath>Things/Building/Structure/ReinforcedWall/ReinforcedWall_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>600</MaxHitPoints>
			<Flammability>0.75</Flammability>
			<WorkToBuild>300</WorkToBuild>
		</statBases>
		<costStuffCount>5</costStuffCount>
		<costList>
			<Steel>10</Steel>
		</costList>
		<building>
			<blueprintGraphicData>
				<texPath>Things/Building/Linked/Wall_Blueprint_Atlas</texPath>
			</blueprintGraphicData>
		</building>
		<damageMultipliers Inherit="false">
			<li>
				<damageDef>Bomb</damageDef>
				<multiplier>0.5</multiplier>
			</li>
			<li>
				<damageDef>Thermobaric</damageDef>
				<multiplier>0.5</multiplier>
			</li>
			<li>
				<damageDef>Bomb_Secondary</damageDef>
				<multiplier>0.5</multiplier>
			</li>
			<li>
				<damageDef>Demolish</damageDef>
				<multiplier>0.5</multiplier>
			</li>
			<li>
				<damageDef>Thump</damageDef>
				<multiplier>0.5</multiplier>
			</li>
		</damageMultipliers>
		<researchPrerequisites>
			<li>Smithing</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="CE_ReinforcedWall">
		<defName>CE_ReinforcedEmbrasure</defName>
		<label>reinforced embrasure</label>
		<description>A strong impassable wall reinforced with steel plates made to withstand lots of abuse and direct explosions. Capable of holding up a roof. Designed with tactical holes to see and fire through.</description>
		<graphicData>
			<texPath>Things/Building/Structure/ReinforcedEmbrasure/ReinforcedEmbrasure_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconPath>Things/Building/Structure/ReinforcedEmbrasure/ReinforcedEmbrasure_MenuIcon</uiIconPath>
		<uiIconPathsStuff Inherit="False">
			<li>
				<appearance>Planks</appearance>
				<iconPath>Things/Building/Embrasure/EmbrasurePlanks_MenuIcon</iconPath>
			</li>
			<li>
				<appearance>Bricks</appearance>
				<iconPath>Things/Building/Embrasure/EmbrasureBricks_MenuIcon</iconPath>
			</li>
		</uiIconPathsStuff>
		<statBases>
			<WorkToBuild>350</WorkToBuild>
		</statBases>
		<fillPercent>0.7</fillPercent>
		<disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
		<building>
			<blueprintGraphicData>
				<texPath>Things/Building/Embrasure/Embrasure_Blueprint_Atlas</texPath>
			</blueprintGraphicData>
			<isStuffableAirtight>false</isStuffableAirtight>
		</building>
	</ThingDef>

</Defs>